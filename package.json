{
  "name": "streakline",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "playwright": "1.65.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 4120",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:small-stack": "node --stack-size=200 node_modules/jest/bin/jest.js --silent",
    "test:zones": "for tz in UTC America/New_York Europe/Istanbul Asia/Kolkata Pacific/Auckland; do echo \"TZ=$tz\"; TZ=$tz jest --silent || exit 1; done",
    "build:web": "expo export --platform web",
    "e2e": "node e2e/run.mjs"
  },
  "private": true,
  "license": "MIT",
  "description": "Offline-first habit tracker and focus timer",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  }
}
